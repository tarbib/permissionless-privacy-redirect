{
  "manifest_version": 3,
  "name": "PrivacyRedirect+",
  "version": "2.0.0",
  "description": "Redirects YouTube, Reddit, X and more to privacy-friendly frontends you choose. No install-time permissions: you grant each site when you turn it on.",
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": [
    "*://youtube.com/*",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtu.be/*",
    "*://x.com/*",
    "*://www.x.com/*",
    "*://twitter.com/*",
    "*://www.twitter.com/*",
    "*://reddit.com/*",
    "*://www.reddit.com/*",
    "*://old.reddit.com/*",
    "*://instagram.com/*",
    "*://www.instagram.com/*",
    "*://tiktok.com/*",
    "*://www.tiktok.com/*",
    "*://*.wikipedia.org/*",
    "*://medium.com/*",
    "*://stackoverflow.com/*",
    "*://imgur.com/*",
    "*://i.imgur.com/*",
    "*://imdb.com/*",
    "*://www.imdb.com/*",
    "*://m.imdb.com/*",
    "*://quora.com/*",
    "*://www.quora.com/*",
    "*://*.fandom.com/*",
    "*://genius.com/*",
    "*://*.bandcamp.com/*",
    "*://github.com/*",
    "*://translate.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PrivacyRedirect+",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
