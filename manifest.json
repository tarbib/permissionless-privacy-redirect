{
  "manifest_version": 3,
  "name": "Permissionless Privacy Redirect",
  "version": "3.0.0",
  "description": "Opens YouTube, Reddit, X and other links in privacy-friendly frontends you choose. Requires no permissions.",
  "omnibox": { "keyword": "pr" },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Permissionless Privacy Redirect",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
